# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env rồi điền giá trị thật.
# File .env nằm trong .gitignore — KHÔNG commit. Trên Railway/Render đặt các biến này trong dashboard.
# ============================================================

# --- Server ---
PORT=8000
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Số uvicorn worker trong Docker
WEB_CONCURRENCY=2

# --- Security (bắt buộc) ---
# Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# --- Redis: state dùng chung cho rate limit + cost guard ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limit: số request / 60 giây cho mỗi API key ---
RATE_LIMIT_PER_MINUTE=10

# --- Cost guard (USD). MONTHLY_BUDGET_USD=0 nghĩa là không giới hạn theo tháng ---
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
PRICE_INPUT_PER_1K=0.00015
PRICE_OUTPUT_PER_1K=0.0006
